# ============================================================
#  BSC INTEGRAL · Variables de entorno
#  ------------------------------------------------------------
#  Pega aquí las dos claves de tu proyecto de Supabase.
#  Las encuentras en:  supabase.com → tu proyecto → Settings → API
#      · Project URL       →  PUBLIC_SUPABASE_URL
#      · anon public key   →  PUBLIC_SUPABASE_ANON_KEY
#
#  Con eso basta: todo el sistema queda conectado.
#  Después de editar este archivo, reinicia  npm run dev
#
#  El prefijo PUBLIC_ es de Astro e indica que la variable viaja
#  al navegador. Es lo correcto para la llave anónima.
#  NUNCA pongas aquí la llave service_role.
# ============================================================

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
